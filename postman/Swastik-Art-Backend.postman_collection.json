        },
        {
          "name": "Add withdrawal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  const withdrawals = body.worker && body.worker.withdrawals;",
                  "  if (withdrawals && withdrawals.length) {",
                  "    pm.collectionVariables.set('withdrawalId', withdrawals[withdrawals.length - 1]._id);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 1000,\n  \"paymentMethod\": \"Cash\",\n  \"note\": \"Advance\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/workers/{{workerId}}/withdrawals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "workers",
                "{{workerId}}",
                "withdrawals"
              ]
            },
            "description": "Adds a withdrawal and saves the new withdrawal ID for the delete request."
          }
        },
