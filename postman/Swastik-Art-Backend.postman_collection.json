            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Worker Name\",\n  \"mobileNumber\": \"9000000000\",\n  \"role\": \"Embroidery Operator\",\n  \"machineType\": \"Embroidery Machine\",\n  \"salary\": 20000,\n  \"bonus\": 0,\n  \"status\": \"Active\",\n  \"notes\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
